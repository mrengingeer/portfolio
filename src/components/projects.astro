---
interface Project {
  title: string;
  category: string;
  description: string;
  image: string;
  technologies: string[];
  github: string;
  demo?: string;
  caseStudy?: string;
  featured?: boolean;
}

const projects: Project[] = [
  {
    title: "Home Assistant Smart Home",
    category: "IoT / Automation",
    description:
      "A locally controlled smart-home ecosystem integrating Home Assistant, ESP32 devices, Zigbee, cameras, vehicle presence and custom automations.",
    image: `${import.meta.env.BASE_URL}/projects/home-assistant.png`,
    technologies: [
      "Home Assistant",
      "ESP32",
      "ESPHome",
      "Zigbee",
      "Frigate",
    ],
    github: "https://github.com/mrengingeer",
    caseStudy: `${import.meta.env.BASE_URL}/projects/home-assistant`,
    featured: true,
  },

  {
    title: "Employee Office Attendance System",
    category: "Full Stack / Enterprise",
    description:
      "Enterprise attendance tracking application with Microsoft Entra ID SSO, workspace validation, IP logging and SQL integration.",
    image: `${import.meta.env.BASE_URL}/projects/attendance.png`,
    technologies: [
      "ASP.NET Core",
      "C#",
      "Entra ID",
      "SQL Server",
      "IIS",
    ],
    github: "https://github.com/mrengingeer",
  },

  {
    title: "Sundar Gutka Android App",
    category: "Android / Kotlin",
    description:
      "Android application for navigating Gurbani through structured bani selection and Ang-based page navigation.",
    image: `${import.meta.env.BASE_URL}/projects/gurbani.png`,
    technologies: [
      "Kotlin",
      "Android",
      "PDF",
    ],
    github: "https://github.com/mrengingeer",
  },

    {
    title: "Driver Fatigue Detection",
    category: "AI / Computer Vision",
    description:
      "Computer vision system combining YOLO-based detection with LSTM temporal analysis to identify driver fatigue.",
    image: `${import.meta.env.BASE_URL}/projects/fatigue.png`,
    technologies: [
      "Python",
      "YOLO",
      "LSTM",
      "PyTorch",
      "Computer Vision",
    ],
    github: "https://github.com/mrengingeer",
  },

  {
    title: "Pothole Detection",
    category: "AI / Computer Vision",
    description:
      "Computer vision system using YOLOv11 to detect and localize potholes and road hazards in images and video.",
    image: `${import.meta.env.BASE_URL}/projects/pothole.gif`,
    technologies: [
      "Python",
      "YOLOv11",
      "PyTorch",
      "Computer Vision",
    ],
    github: "https://github.com/mrengingeer",
  },
];
---

<section
  id="projects"
  class="py-16 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">

    <!-- Section heading -->
    <div class="mb-12">
      <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">
        Selected Work
      </h2>

      <h3 class="text-4xl md:text-5xl font-medium">
        Things I've built
      </h3>

      <p class="mt-4 max-w-2xl text-[var(--white-icon)] text-base md:text-lg">
        A collection of systems, applications, experiments and engineering
        projects spanning software development, AI, automation and IoT.
      </p>
    </div>


    <!-- Featured Project -->
    {
      projects
        .filter((project) => project.featured)
        .map((project) => (
          <article class="group mb-14">

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">

              <!-- Project image -->
              <a
                href={project.caseStudy}
                class="block overflow-hidden rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c]"
              >
                <img
                  src={project.image}
                  alt={project.title}
                  class="w-full aspect-video object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
              </a>


              <!-- Project information -->
              <div>

                <p class="text-sm uppercase tracking-widest text-[var(--sec)] mb-3">
                  Featured Project · {project.category}
                </p>

                <h4 class="text-3xl md:text-4xl font-semibold mb-4">
                  {project.title}
                </h4>

                <p class="text-[var(--white-icon)] text-base md:text-lg leading-relaxed mb-6">
                  {project.description}
                </p>


                <!-- Technologies -->
                <div class="flex flex-wrap gap-2 mb-7">
                  {
                    project.technologies.map((technology) => (
                      <span class="px-3 py-1.5 rounded-full border border-[var(--white-icon-tr)] bg-[#1414149c] text-sm text-[var(--white-icon)]">
                        {technology}
                      </span>
                    ))
                  }
                </div>


                <!-- Links -->
                <div class="flex flex-wrap gap-3">

                  {
                    project.caseStudy && (
                      <a
                        href={project.caseStudy}
                        class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-[var(--sec)] text-[var(--background)] font-medium hover:scale-105 transition-transform duration-300"
                      >
                        View Case Study
                        <span>→</span>
                      </a>
                    )
                  }

                  <a
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-5 py-3 rounded-full border border-[var(--white-icon-tr)] text-[var(--white-icon)] hover:text-white hover:bg-[var(--white-icon-tr)] transition duration-300"
                  >
                    GitHub ↗
                  </a>

                </div>

              </div>

            </div>

          </article>
        ))
    }


    <!-- Other Projects -->
    <div class="mt-16">

      <div class="flex items-end justify-between mb-8">

        <div>
          <p class="text-sm uppercase tracking-widest text-[var(--sec)] mb-2">
            More Work
          </p>

          <h4 class="text-3xl md:text-4xl font-medium">
            Other Projects
          </h4>
        </div>

      </div>


      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        {
          projects
            .filter((project) => !project.featured)
            .map((project) => (
              <article class="group rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c] overflow-hidden hover:border-[#ffffff25] transition duration-300">

                <!-- Image -->
                <div class="overflow-hidden">
                  <img
                    src={project.image}
                    alt={project.title}
                    class="w-full aspect-video object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                </div>


                <!-- Content -->
                <div class="p-6">

                  <p class="text-xs uppercase tracking-widest text-[var(--sec)] mb-2">
                    {project.category}
                  </p>

                  <h5 class="text-2xl font-semibold mb-3">
                    {project.title}
                  </h5>

                  <p class="text-[var(--white-icon)] leading-relaxed mb-5">
                    {project.description}
                  </p>


                  <!-- Technologies -->
                  <div class="flex flex-wrap gap-2 mb-6">
                    {
                      project.technologies.map((technology) => (
                        <span class="px-2.5 py-1 rounded-full bg-[#ffffff08] text-xs text-[var(--white-icon)]">
                          {technology}
                        </span>
                      ))
                    }
                  </div>


                  <!-- Links -->
                  <div class="flex gap-3">

                    <a
                      href={project.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex-1 text-center py-2.5 rounded-full border border-[var(--white-icon-tr)] text-sm text-[var(--white-icon)] hover:text-white hover:bg-[var(--white-icon-tr)] transition"
                    >
                      GitHub ↗
                    </a>

                    {
                      project.demo && (
                        <a
                          href={project.demo}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="flex-1 text-center py-2.5 rounded-full bg-[var(--sec)] text-sm text-[var(--background)] hover:scale-105 transition"
                        >
                          Live Demo
                        </a>
                      )
                    }

                  </div>

                </div>

              </article>
            ))
        }

      </div>

    </div>


    <!-- GitHub -->
    <a
      target="_blank"
      rel="noopener noreferrer"
      href="https://github.com/mrengingeer"
      class="w-full flex items-center justify-center gap-2 mt-12 text-[var(--white-icon)] hover:text-white transition duration-300 border border-[var(--white-icon-tr)] p-4 rounded-full bg-[#1414149c] hover:bg-[var(--white-icon-tr)] hover:scale-[1.02]"
    >
      <span class="md:text-lg text-md">
        Explore more projects on GitHub
      </span>

      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        class="size-6"
      >
        <path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z" />
      </svg>
    </a>

  </div>
</section>