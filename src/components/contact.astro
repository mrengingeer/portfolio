<section id="contact" class="w-full py-16 border-t border-[#ffffff10]">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">
      Let's talk
    </h2>

    <h3 class="text-4xl md:text-5xl font-medium text-[var(--white)] mb-6">
      Contact
    </h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16">
      <!-- Left side -->
      <div class="text-[var(--white-icon)]">
        <p class="mb-5 text-base md:text-lg">
          Let's connect! Whether you have a project, opportunity, question, or
          just want to say hello, feel free to reach out.
        </p>

        <p class="text-sm md:text-base text-[var(--white-icon)] mb-8">
          I'll get back to you as soon as I can.
        </p>

      <!-- Interactive phone terminal -->
<div
  class="w-full rounded-xl border border-[var(--white-icon-tr)] bg-[#1414149c] overflow-hidden shadow-lg"
>
  <!-- Terminal header -->
  <div
    class="flex items-center gap-2 px-4 py-3 border-b border-[#ffffff10] bg-[#111111]"
  >
    <span class="w-2.5 h-2.5 rounded-full bg-[#ff5f56]"></span>
    <span class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e]"></span>
    <span class="w-2.5 h-2.5 rounded-full bg-[#27c93f]"></span>

    <span class="ml-2 text-xs text-[var(--white-icon)] font-mono">
      taninder@portfolio:~$
    </span>
  </div>

  <!-- Terminal body -->
  <div
    id="phone-terminal"
    class="p-5 font-mono text-sm min-h-[230px]"
  >
    <!-- Instructions -->
    <div class="text-[var(--white-icon)]">
      Enter command to reveal phone number.
    </div>

    <div class="text-[var(--white-icon)] mt-1">
      Type
      <span class="text-[var(--sec)]">reveal</span>
      and press Enter.
    </div>

    <!-- Terminal history -->
    <div id="terminal-history" class="mt-4 space-y-2"></div>

    <!-- Command line -->
    <div class="flex items-center mt-4">
      <span class="text-[var(--sec)] mr-2">$</span>

      <input
        id="terminal-command"
        type="text"
        autocomplete="off"
        spellcheck="false"
        aria-label="Terminal command"
        class="flex-1 bg-transparent border-none outline-none text-[var(--white)] font-mono caret-[var(--sec)]"
        placeholder="enter command..."
      />
    </div>

    <!-- Phone controls -->
    <div id="phone-actions" class="hidden mt-5">
      <div class="flex flex-wrap gap-3">
        <!-- Call -->
        <a
          href="tel:+1YOURPHONENUMBER"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-[var(--white-icon-tr)] bg-[#ffffff05] text-[var(--white)] transition-all hover:bg-[var(--sec)] hover:text-[var(--background)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M22 16.92v3a2 2 0 0 1-2.18 2
              19.79 19.79 0 0 1-8.63-3.07
              19.5 19.5 0 0 1-6-6
              19.79 19.79 0 0 1-3.07-8.67
              A2 2 0 0 1 4.11 2h3
              a2 2 0 0 1 2 1.72
              12.84 12.84 0 0 0 .7 2.81
              2 2 0 0 1-.45 2.11L8.09 9.91
              a16 16 0 0 0 6 6l1.27-1.27
              a2 2 0 0 1 2.11-.45
              12.84 12.84 0 0 0 2.81.7
              A2 2 0 0 1 22 16.92z"
            />
          </svg>

          Call
        </a>

        <!-- Copy -->
        <button
          id="copy-phone"
          type="button"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-[var(--white-icon-tr)] bg-[#ffffff05] text-[var(--white)] transition-all hover:bg-[var(--sec)] hover:text-[var(--background)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect width="14" height="14" x="8" y="8" rx="2" />
            <path
              d="M4 16c-1.1 0-2-.9-2-2V4
              c0-1.1.9-2 2-2h10
              c1.1 0 2 .9 2 2"
            />
          </svg>

          <span id="copy-text">Copy</span>
        </button>
      </div>
    </div>
  </div>
</div>
      </div>

      <!-- Right side: Contact form -->
      <div>
        <form
          id="contact-form"
          action="https://formspree.io/f/xvkgdoby"
          method="POST"
          class="flex flex-col gap-4"
        >
          <input
            type="text"
            name="name"
            placeholder="Name"
            autocomplete="name"
            required
            class="px-4 py-3 bg-[#1414149c] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)] placeholder:text-[var(--white-icon)]"
          />

          <input
            type="email"
            name="email"
            placeholder="Email"
            autocomplete="email"
            required
            class="px-4 py-3 bg-[#1414149c] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)] placeholder:text-[var(--white-icon)]"
          />

          <textarea
            name="message"
            placeholder="Message"
            rows="6"
            required
            class="px-4 py-3 bg-[#1414149c] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)] placeholder:text-[var(--white-icon)] resize-none"
          ></textarea>

          <button
            id="contact-submit"
            type="submit"
            class="px-4 py-3 bg-[var(--white-icon-tr)] text-[var(--white)] rounded-lg border border-[var(--white-icon-tr)] transition-all hover:bg-[var(--sec)] hover:text-[var(--background)] disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Send Message
          </button>
        </form>

        <!-- Success message -->
        <div
          id="form-success"
          class="hidden mt-5 p-4 rounded-lg border border-[#ffffff10] bg-[#1414149c] text-[var(--white)]"
        >
          Thanks for reaching out! Your message has been sent successfully.
        </div>

        <!-- Error message -->
        <div
          id="form-error"
          class="hidden mt-5 p-4 rounded-lg border border-[#ffffff10] bg-[#1414149c] text-[var(--white)]"
        >
          Something went wrong while sending your message. Please try again.
        </div>
      </div>
    </div>
  </div>
</section>

<script type="module" is:inline>
  // ================================
  // Phone Terminal
  // ================================

  const phoneLoading = document.getElementById("phone-loading");
  const phoneProgress = document.getElementById("phone-progress");
  const phonePercent = document.getElementById("phone-percent");
  const phoneResult = document.getElementById("phone-result");
  const copyPhone = document.getElementById("copy-phone");
  const copyText = document.getElementById("copy-text");

  let progress = 0;

  const progressInterval = setInterval(() => {
    progress += Math.floor(Math.random() * 8) + 3;

    if (progress >= 100) {
      progress = 100;
      clearInterval(progressInterval);

      setTimeout(() => {
        phoneLoading.classList.add("hidden");
        phoneResult.classList.remove("hidden");
      }, 400);
    }

    phoneProgress.style.width = `${progress}%`;
    phonePercent.textContent = `${progress}%`;
  }, 80);

  // ================================
  // Copy Phone Number
  // ================================

  copyPhone.addEventListener("click", async () => {
    const phoneNumber = "+16473037432";

    try {
      await navigator.clipboard.writeText(phoneNumber);

      copyText.textContent = "Copied!";

      setTimeout(() => {
        copyText.textContent = "Copy";
      }, 2000);
    } catch (error) {
      console.error("Unable to copy phone number:", error);
      copyText.textContent = "Failed";

      setTimeout(() => {
        copyText.textContent = "Copy";
      }, 2000);
    }
  });

  // ================================
  // Contact Form
  // ================================

  const form = document.getElementById("contact-form");
  const submitButton = document.getElementById("contact-submit");
  const successMessage = document.getElementById("form-success");
  const errorMessage = document.getElementById("form-error");

  form.addEventListener("submit", async (event) => {
    event.preventDefault();

    successMessage.classList.add("hidden");
    errorMessage.classList.add("hidden");

    submitButton.disabled = true;
    submitButton.textContent = "Sending...";

    const formData = new FormData(form);

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: formData,
        headers: {
          Accept: "application/json",
        },
      });

      if (response.ok) {
        form.reset();
        form.style.display = "none";
        successMessage.classList.remove("hidden");
      } else {
        errorMessage.classList.remove("hidden");
        submitButton.disabled = false;
        submitButton.textContent = "Send Message";
      }
    } catch (error) {
      console.error("Form submission error:", error);

      errorMessage.classList.remove("hidden");
      submitButton.disabled = false;
      submitButton.textContent = "Send Message";
    }
  });
</script>