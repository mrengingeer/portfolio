---
interface Props {
  title: string;
}

const { title } = Astro.props;

const siteUrl = "https://mrengingeer.github.io/portfolio";
const siteName = "Taninder Thiara";
const description =
  "Taninder Thiara is a Software Engineer and Problem Solver building across software development, AI/ML, automation, cloud, and data.";
const ogImage = `${siteUrl}/og.image.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <title>{title} | {siteName}</title>

    <meta
      name="description"
      content={description}
    />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta name="author" content="Taninder Thiara" />

    <meta
      name="keywords"
      content="Taninder Thiara, Software Engineer, Software Developer, AI, Machine Learning, Full Stack Developer, Python, Java, React, Cloud, Automation"
    />

    <meta name="robots" content="index, follow" />

    <!-- Favicon -->
    <link
      rel="icon"
      type="image/png"
      href={`${import.meta.env.BASE_URL}/favicon.png`}
    />

    <!-- Canonical URL -->
    <link
      rel="canonical"
      href={siteUrl}
    />

    <!-- Font -->
    <link
      rel="preload"
      href={`${import.meta.env.BASE_URL}/fonts/montserrat-latin-wght-normal.woff2`}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <!-- Open Graph / Social Sharing -->
    <meta
      property="og:title"
      content={`${siteName} | Software Engineer`}
    />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:image"
      content={ogImage}
    />

    <meta
      property="og:url"
      content={siteUrl}
    />

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:site_name"
      content={siteName}
    />

    <meta
      property="og:locale"
      content="en_CA"
    />

    <!-- Twitter / X -->
    <meta
      name="twitter:card"
      content="summary_large_image"
    />

    <meta
      name="twitter:title"
      content={`${siteName} | Software Engineer`}
    />

    <meta
      name="twitter:description"
      content={description}
    />

    <meta
      name="twitter:image"
      content={ogImage}
    />

    <!-- Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Taninder Thiara",
        "url": "https://mrengingeer.github.io/portfolio",
        "image": "https://mrengingeer.github.io/portfolio/og.image.png",
        "jobTitle": "Software Engineer",
        "description": "Software Engineer and Problem Solver building across software development, AI/ML, automation, cloud, and data.",
        "sameAs": [
          "https://github.com/mrengingeer",
          "https://www.linkedin.com/in/taninder-thiara/"
        ]
      }
    </script>
  </head>

  <body class="bg-[--background] sm:px-28 lg:px-20 px-9">
    <slot />
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Montserrat Variable";
    src: url(`${import.meta.env.BASE_URL}/fonts/montserrat-latin-wght-normal.woff2`)
      format("woff2-variations");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --background: #101010;
    --sec: #a476ff;
    --white: #dfdfdf;
    --white-icon: #f3f3f398;
    --white-icon-tr: #f3f3f310;
  }

  * {
    font-family:
      "Montserrat Variable",
      -apple-system,
      system-ui,
      sans-serif;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  *::selection {
    background-color: var(--sec);
    color: var(--background);
  }

  /* Scrollbar styles */

  ::-webkit-scrollbar {
    width: 15px;
  }

  ::-webkit-scrollbar-track {
    background: var(--container);
    border-radius: 30px;
  }

  ::-webkit-scrollbar-thumb {
    background: var(--background);
    border-radius: 10px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--pink);
  }

  /* Scrollbar styles for Firefox */

  * {
    scrollbar-width: thin;
    scrollbar-color: var(--line) var(--container);
  }
</style>